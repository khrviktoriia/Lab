#include <iostream>
#include <future>
#include <deque>
#include <mutex>
#include <condition_variable>
#include <thread>
#include <vector>

long long getNthPrime(int n) {
    int count = 0;
    long long num = 1;
    while (count < n) {
        num++;
        bool prime = true;
        for (long long i = 2; i * i <= num; ++i) {
            if (num % i == 0) { prime = false; break; }
        }
        if (prime) count++;
    }
    return num;
}

std::deque<std::packaged_task<long long()>> task_queue;
std::deque<int> num_queue;
std::mutex mtx;
std::condition_variable cv;
bool stop_worker = false;

void Worker() {
    while (true) {
        std::packaged_task<long long()> task;
        {
            std::unique_lock<std::mutex> lk(mtx);
            cv.wait(lk, [] { return !task_queue.empty() || stop_worker; });

            if (stop_worker && task_queue.empty()) break;

            task = std::move(task_queue.front());
            task_queue.pop_front();
        }
        task();
    }
}

int main() {
    std::thread worker_thread(Worker);
    std::vector<std::future<long long>> futures;
    std::vector<int> requested_n;

    std::cout << "Вводьте числа n (введіть 0 для завершення вводу):\n";
    while (true) {
        int n;
        std::cout << "n = ";
        std::cin >> n;
        if (n <= 0) break;

        std::packaged_task<long long()> task([n]() { return getNthPrime(n); });
        futures.push_back(task.get_future());
        requested_n.push_back(n);

        {
            std::lock_guard<std::mutex> lk(mtx);
            task_queue.push_back(std::move(task));
            num_queue.push_back(n);
        }
        cv.notify_one();
    }

    {
        std::lock_guard<std::mutex> lk(mtx);
        stop_worker = true;
    }
    cv.notify_all();

    worker_thread.join();

    std::cout << "\n--- Результати обчислень ---\n";
    for (size_t idx = 0; idx < futures.size(); ++idx) {
        std::cout << requested_n[idx] << "-те просте число: " << futures[idx].get() << "\n";
    }

    return 0;
}

