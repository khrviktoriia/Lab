#include <iostream>
#include <thread>
#include <queue>
#include <mutex>
#include <chrono>

std::queue<int> data_queue;
std::mutex m;
bool data_ready = false;

bool is_prime(int n) {
    if (n <= 1) return false;
    for (int i = 2; i * i <= n; ++i) {
        if (n % i == 0) return false;
    }
    return true;
}

void DataPreparation() {
    std::cout << "[DataPreparation] Введіть числа (-1 для завершення):\n";
    int num;
    while (std::cin >> num && num != -1) {
        std::lock_guard<std::mutex> lock(m);
        data_queue.push(num);
    }
    {
        std::lock_guard<std::mutex> lock(m);
        data_ready = true;
    }
}

void DataProcessing() {
    while (true) {
        {
            std::unique_lock<std::mutex> lk(m);
            if (!data_ready) {
                lk.unlock();
                std::this_thread::sleep_for(std::chrono::milliseconds(100));
                continue;
            }
        }
        break;
    }

    std::lock_guard<std::mutex> lk(m);
    std::cout << "[DataProcessing] Прості числа з черги: ";
    while (!data_queue.empty()) {
        int val = data_queue.front();
        data_queue.pop();
        if (is_prime(val)) {
            std::cout << val << " ";
        }
    }
    std::cout << "\n";
}

int main() {
    std::thread t_prep(DataPreparation);
    t_prep.detach();

    DataProcessing();

    return 0;
}


