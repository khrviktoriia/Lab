#include <iostream>
#include <thread>
#include <queue>
#include <mutex>
#include <condition_variable>

std::queue<int> data_queue;
std::mutex m;
std::condition_variable cv;
bool done = false;

bool is_prime(int n) {
    if (n <= 1) return false;
    for (int i = 2; i * i <= n; ++i) {
        if (n % i == 0) return false;
    }
    return true;
}

void DataPreparation() {
    std::cout << "[DataPreparation] Введіть числа (-1 для завершення):\n";
    int num;
    while (std::cin >> num && num != -1) {
        {
            std::lock_guard<std::mutex> lock(m);
            data_queue.push(num);
        }
        cv.notify_one();
    }
    {
        std::lock_guard<std::mutex> lock(m);
        done = true;
    }
    cv.notify_all();
}

void DataProcessing() {
    while (true) {
        std::unique_lock<std::mutex> lk(m);
        cv.wait(lk, [] { return !data_queue.empty() || done; });

        while (!data_queue.empty()) {
            int val = data_queue.front();
            data_queue.pop();
            if (is_prime(val)) {
                std::cout << "Знайдено просте число: " << val << "\n";
            }
        }

        if (done && data_queue.empty()) break;
    }
}

int main() {
    std::thread t_prep(DataPreparation);
    t_prep.detach();

    DataProcessing();

    return 0;
}

