#include <iostream>
#include <future>
#include <thread>
#include <cmath>
#include <chrono>

long long getNthPrime(int n) {
    int count = 0;
    long long num = 1;
    while (count < n) {
        num++;
        bool prime = true;
        for (long long i = 2; i * i <= num; ++i) {
            if (num % i == 0) { prime = false; break; }
        }
        if (prime) count++;
    }
    return num;
}

void Thread1(int n, std::promise<long long> p_nth, std::promise<long long> p_10nth, std::promise<bool> p_sync) {
    long long prime_n = getNthPrime(n);
    p_nth.set_value(prime_n);

    p_sync.set_value(true);

    long long prime_10n = getNthPrime(n * 10);
    p_10nth.set_value(prime_10n);
}

void Thread2(int n, std::future<bool> f_sync) {
    if (f_sync.get()) {
        std::this_thread::sleep_for(std::chrono::seconds(2));
        std::cout << "[Thread 2] sqrt(" << n << ") = " << std::sqrt(n) << "\n";
    }
}

int main() {
    int n;
    std::cout << "Введіть n: ";
    std::cin >> n;

    std::promise<long long> p_nth;
    std::promise<long long> p_10nth;
    std::promise<bool> p_sync;

    std::future<long long> f_nth = p_nth.get_future();
    std::future<long long> f_10nth = p_10nth.get_future();
    std::future<bool> f_sync = p_sync.get_future();

    std::thread t1(Thread1, n, std::move(p_nth), std::move(p_10nth), std::move(p_sync));
    std::thread t2(Thread2, n, std::move(f_sync));

    std::cout << "[Main] " << n << "-те просте число: " << f_nth.get() << "\n";
    std::cout << "[Main] " << (n * 10) << "-те просте число: " << f_10nth.get() << "\n";

    t1.join();
    t2.join();

    return 0;
}


