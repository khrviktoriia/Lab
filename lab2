#include <iostream>
#include <future>
#include <cmath>
#include <chrono>
#include <string>

long long getNthPrime(int n) {
    int count = 0;
    long long num = 1;
    while (count < n) {
        num++;
        bool prime = true;
        for (long long i = 2; i * i <= num; ++i) {
            if (num % i == 0) { prime = false; break; }
        }
        if (prime) count++;
    }
    return num;
}

void run_test(std::launch policy, const std::string& name, int n) {
    std::cout << "\n Тест з " << name << " ---\n";
    auto start = std::chrono::high_resolution_clock::now();

    std::future<long long> f = std::async(policy, getNthPrime, n);

    std::cout << "Поки йде/чекає обчислення, вирахуємо sqrt(" << n << "): " << std::sqrt(n) << "\n";

    long long result = f.get();

    auto end = std::chrono::high_resolution_clock::now();
    std::chrono::duration<double> diff = end - start;
    std::cout << n << "-те просте число = " << result << "\n";
    std::cout << "Загальний час виконання: " << diff.count() << " сек.\n";
}

int main() {
    int n;
    std::cout << "Введіть номер n (наприклад, 10000): ";
    std::cin >> n;

    run_test(std::launch::deferred, "std::launch::deferred", n);
    run_test(std::launch::async, "std::launch::async", n);

    return 0;
}


